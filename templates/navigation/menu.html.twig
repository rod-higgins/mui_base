{#
/**
 * @file
 * web/themes/custom/mui_base/templates/navigation/menu.html.twig
 * 
 * Theme override to display a menu with MUI sidebar integration.
 */
#}

{% import _self as menus %}

{# Determine if this is a sidebar menu based on context #}
{% set is_sidebar_menu = attributes.hasClass('MuiSidebarMenu-root') or menu_name in ['main', 'sidebar', 'secondary'] %}

{# Set appropriate classes #}
{%
  set menu_classes = [
    'MuiList-root',
    is_sidebar_menu ? 'MuiSidebarMenu-root' : '',
    is_sidebar_menu ? 'MuiSidebarMenu-collapsible' : '',
    'mui-menu',
    'menu--' ~ menu_name|clean_class,
  ]
%}

{% if items %}
  <nav{{ attributes.addClass(menu_classes) }} 
       aria-label="{{ menu_name|title ~ ' menu'|t }}" 
       data-menu-name="{{ menu_name }}">
    
    {% if is_sidebar_menu %}
      <!-- Sidebar Menu Structure -->
      <ul class="MuiSidebarMenu-list">
        {{ menus.menu_links(items, attributes, 0, menu_name, true) }}
      </ul>
    {% else %}
      <!-- Regular Menu Structure -->
      <ul class="MuiList-root">
        {{ menus.menu_links(items, attributes, 0, menu_name, false) }}
      </ul>
    {% endif %}
    
  </nav>
{% endif %}

{# Recursive macro for rendering menu items #}
{% macro menu_links(items, attributes, menu_level, menu_name, is_sidebar) %}
  {% import _self as menus %}
  
  {% for item in items %}
    {%
      set item_classes = [
        'MuiListItem-root',
        is_sidebar ? 'MuiSidebarMenu-item' : '',
        menu_level > 0 ? (is_sidebar ? 'MuiSidebarMenu-subitem' : 'menu__item--sublevel') : '',
        item.below ? (is_sidebar ? 'MuiSidebarMenu-hasChildren' : 'menu__item--has-children') : '',
        item.in_active_trail ? (is_sidebar ? 'MuiSidebarMenu-activeTrail' : 'menu__item--active-trail') : '',
        is_sidebar ? 'MuiSidebarMenu-level-' ~ menu_level : 'menu__item--level-' ~ menu_level,
      ]
    %}
    
    {%
      set link_classes = [
        'MuiListItemButton-root',
        'MuiButtonBase-root',
        is_sidebar ? 'MuiSidebarMenu-link' : 'menu__link',
        item.in_active_trail ? (is_sidebar ? 'MuiSidebarMenu-activeTrail' : 'menu__link--active-trail') : '',
        menu_level > 0 ? (is_sidebar ? 'MuiSidebarMenu-sublevelLink' : 'menu__link--sublevel') : '',
      ]
    %}
    
    <li{{ item.attributes.addClass(item_classes) }}>
      
      <div class="{{ is_sidebar ? 'MuiSidebarMenu-itemWrapper' : 'menu__item-wrapper' }}">
        
        <!-- Main link -->
        <a href="{{ item.url }}" {{ item.link_attributes.addClass(link_classes) }}>
          
          <!-- Indent for nested items in sidebar -->
          {% if is_sidebar and menu_level > 0 %}
            <span class="MuiSidebarMenu-indent" style="width: {{ menu_level * 16 }}px;"></span>
          {% endif %}
          
          <!-- Link content -->
          <span class="MuiListItemText-root">
            <span class="MuiListItemText-primary {{ is_sidebar ? 'MuiSidebarMenu-linkText' : 'menu__link-text' }}">
              {{ item.title }}
            </span>
          </span>
          
          <!-- Active indicator for sidebar -->
          {% if is_sidebar and item.in_active_trail %}
            <span class="MuiSidebarMenu-activeIndicator"></span>
          {% endif %}
          
        </a>
        
        <!-- Expand/Collapse button for items with children -->
        {% if item.below and is_sidebar %}
          <button 
            class="MuiSidebarMenu-expandButton MuiIconButton-root"
            aria-label="{{ 'Toggle submenu for'|t }} {{ item.title }}"
            aria-expanded="false"
            type="button"
            data-target="submenu-{{ loop.index }}-{{ menu_level }}"
          >
            <svg class="MuiSvgIcon-root MuiSidebarMenu-expandIcon" focusable="false" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z"></path>
            </svg>
          </button>
        {% endif %}
        
      </div>
      
      <!-- Submenu -->
      {% if item.below %}
        <div 
          class="{{ is_sidebar ? 'MuiSidebarMenu-submenu MuiCollapse-root MuiSidebarMenu-collapsible' : 'menu__submenu' }}"
          id="{{ is_sidebar ? 'submenu-' ~ loop.index ~ '-' ~ menu_level : '' }}"
          {% if is_sidebar %}aria-hidden="true"{% endif %}
        >
          <ul class="{{ is_sidebar ? 'MuiSidebarMenu-submenuList MuiList-root' : 'MuiList-root menu__submenu-list' }}">
            {{ menus.menu_links(item.below, attributes, menu_level + 1, menu_name, is_sidebar) }}
          </ul>
        </div>
      {% endif %}
      
    </li>
  {% endfor %}
{% endmacro %}